# MongoDB connection string (Atlas or local instance)
MONGODB_URI=mongodb://localhost:27017/ai-interview-prep-kit

# Secret key for JWT session signing
JWT_SECRET=supersecret_jwt_key_for_session_tokens_minimum_32_chars

# Google Gemini API key (gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily API key for public discussion search (optional, native fallback included)
TAVILY_API_KEY=your_tavily_api_key_here

# Evaluator mode flag (set to true during npm run evaluate to allow internal/localhost target URLs)
EVALUATOR_MODE=false
